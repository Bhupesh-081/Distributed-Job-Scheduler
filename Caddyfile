# Local dev: {$SITE_ADDRESS} defaults to "localhost" -> Caddy issues itself a
# self-signed cert automatically ("internal" cert, trusted only by Caddy's
# own local CA). Point SITE_ADDRESS at a real domain in production and Caddy
# switches to fetching a real cert from Let's Encrypt automatically instead
# — no config change needed.
{$SITE_ADDRESS:localhost} {
	reverse_proxy api:8080
}
